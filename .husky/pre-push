#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# A push to main is a deploy: Cloudflare Pages builds it and serves it with
# no staging in between. So nothing is pushed that does not type-check, pass
# its tests and build. Never bypass this with --no-verify on main.

# engineStrict wants Node 24; this machine defaults to a newer one
if [ -d /opt/homebrew/opt/node@24/bin ]; then
  export PATH="/opt/homebrew/opt/node@24/bin:$PATH"
fi

pnpm ts-check && pnpm test && pnpm build-fe
