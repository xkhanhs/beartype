{
  "name": "beartype",
  "version": "26.32.0",
  "private": true,
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "dev": "vite dev",
    "build": "vite build",
    "build-fe": "pnpm build",
    "preview": "vite preview",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage",
    "ts-check": "tsc --noEmit",
    "lint": "oxlint . --type-aware --type-check",
    "lint-fast": "oxlint .",
    "lint-fix": "oxlint . --fix",
    "format-check": "oxfmt . --check",
    "format-fix": "oxfmt .",
    "lint-styles": "stylelint \"**/*.{scss,css}\"",
    "lint-styles-fix": "stylelint \"**/*.{scss,css}\" --fix",
    "knip": "knip"
  },
  "dependencies": {
    "@leonabcd123/modern-caps-lock": "3.1.3",
    "@solid-primitives/refs": "1.1.3",
    "@solid-primitives/transition-group": "1.1.2",
    "@solidjs/meta": "0.29.4",
    "animejs": "4.2.2",
    "balloon-css": "1.2.0",
    "canvas-confetti": "1.9.4",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "hangul-js": "0.2.6",
    "howler": "2.2.3",
    "tailwind-merge": "3.6.0",
    "throttle-debounce": "5.0.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "5.15.4",
    "@oxlint/plugins": "1.43.0",
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "@types/canvas-confetti": "1.9.0",
    "@types/howler": "2.2.7",
    "@types/node": "24.9.1",
    "@types/throttle-debounce": "5.0.2",
    "@vitest/coverage-v8": "4.1.5",
    "autoprefixer": "10.4.27",
    "caniuse-lite": "1.0.30001778",
    "eslint-plugin-compat": "7.0.0",
    "eslint-plugin-solid": "0.14.5",
    "fontawesome-subset": "4.6.0",
    "happy-dom": "20.8.9",
    "husky": "8.0.1",
    "jsdom": "27.4.0",
    "knip": "6.35.1",
    "lint-staged": "13.2.3",
    "magic-string": "0.30.17",
    "normalize.css": "8.0.1",
    "only-allow": "1.2.1",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "postcss": "8.5.24",
    "sass": "1.70.0",
    "solid-js": "1.9.13",
    "stylelint": "17.6.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "tailwindcss": "4.3.2",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "unplugin-inject-preload": "3.0.0",
    "vite": "8.0.5",
    "vite-plugin-html-inject": "1.1.2",
    "vite-plugin-minify": "2.1.0",
    "vite-plugin-solid": "2.11.11",
    "vitest": "4.1.0",
    "yaml": "2.8.3"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{ts,tsx,js}": [
      "oxlint --type-aware --type-check"
    ],
    "*.{scss,css}": [
      "stylelint"
    ]
  },
  "browserslist": [
    "baseline widely available and > 0.002%"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@11.21.0"
}
