{
  "name": "beartype",
  "version": "26.32.0",
  "private": true,
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "ts-check": "pnpm --dir frontend ts-check",
    "lint": "pnpm --dir frontend lint",
    "lint-fix": "pnpm --dir frontend lint-fast --fix",
    "build": "pnpm --dir frontend build",
    "build-fe": "pnpm build",
    "test": "pnpm --dir frontend test",
    "dev-fe": "pnpm --dir frontend dev",
    "start-fe": "pnpm --dir frontend start",
    "format-check": "oxfmt . --check",
    "format-fix": "oxfmt .",
    "lint-styles": "stylelint \"**/*.{scss,css}\"",
    "lint-styles-fix": "stylelint \"**/*.{scss,css}\" --fix",
    "knip": "knip"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.43.0",
    "@types/node": "24.9.1",
    "@vitest/coverage-v8": "4.1.5",
    "caniuse-lite": "1.0.30001778",
    "husky": "8.0.1",
    "knip": "6.35.1",
    "lint-staged": "13.2.3",
    "only-allow": "1.2.1",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "stylelint": "17.6.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "vitest": "4.1.0",
    "yaml": "2.8.3"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{ts,tsx,js}": [
      "oxlint --type-aware --type-check"
    ],
    "*.{scss,css}": [
      "stylelint"
    ]
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@11.21.0"
}
