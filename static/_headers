# The bundle's file names carry a content hash, so a file never changes
# under its name and can be kept for good.
/js/*
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=31536000, immutable

# The page itself names those files, so it has to be fetched fresh every
# time -- a cached page would keep pointing at the previous release.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
